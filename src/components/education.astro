---
import { Icon } from 'astro-icon/components';
import localData from '../data/education.json';

interface EducationEntry {
  degree: string;
  institution: string;
  campus: string | null;
  period: string;
  status: string;
  icon: string;
}

const isApiLive = import.meta.env.PROD;
const BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;

let entries: EducationEntry[];

if (isApiLive && BASE_URL) {
  try {
    const response = await fetch(`${BASE_URL}/education`);
    if (!response.ok) throw new Error('Network response was not ok');
    entries = await response.json();
  } catch {
    entries = localData as EducationEntry[];
  }
} else {
  entries = localData as EducationEntry[];
}
---

<section id="education" class="section-container overflow-hidden">
  <div class="container mx-auto">

    <div class="edu-header">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-2 flex items-center gap-4">
        <span class="text-accent">/</span> Educación
      </h2>
      <p class="text-gray font-body text-sm max-w-md pb-10">
        Formación académica formal
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {entries.map((entry) => {
        const isCurrent = entry.status === 'En curso';
        return (
          <div class={`edu-card group relative flex flex-col gap-5 p-6 rounded-2xl border transition-all duration-300
            ${isCurrent
              ? 'bg-accent/5 border-accent/30 shadow-[0_0_40px_rgba(164,118,255,0.08)] hover:shadow-[0_0_50px_rgba(164,118,255,0.15)] hover:border-accent/50'
              : 'bg-white/5 border-white/10 hover:border-white/20 hover:bg-white/8'
            }`}
          >

            {/* Top row: icon + status badge */}
            <div class="flex items-start justify-between">
              <div class={`w-12 h-12 rounded-xl flex items-center justify-center
                ${isCurrent ? 'bg-accent/15' : 'bg-white/8'}`}
              >
                <Icon
                  name={entry.icon}
                  class={`w-6 h-6 transition-colors ${isCurrent ? 'text-accent' : 'text-white/60 group-hover:text-white/80'}`}
                />
              </div>

              <div class="flex items-center gap-2">
                {isCurrent && (
                  <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
                  </span>
                )}
                <span class={`text-[10px] font-body font-medium uppercase tracking-widest px-3 py-1 rounded-full border
                  ${isCurrent
                    ? 'text-accent border-accent/30 bg-accent/10'
                    : 'text-white/50 border-white/10 bg-white/5'
                  }`}
                >
                  {entry.status}
                </span>
              </div>
            </div>

            {/* Degree + institution */}
            <div class="flex-1">
              <h3 class="text-xl font-heading font-bold text-white leading-snug mb-2">
                {entry.degree}
              </h3>
              <p class={`font-body text-sm font-medium ${isCurrent ? 'text-accent/80' : 'text-white/60'}`}>
                {entry.institution}
              </p>
              {entry.campus && (
                <p class="font-body text-xs text-white/40 mt-0.5">
                  {entry.campus}
                </p>
              )}
            </div>

            {/* Period */}
            <div class="pt-4 border-t border-white/8">
              <span class="font-mono text-xs tracking-widest uppercase text-accent/70">
                {entry.period}
              </span>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
  .edu-header {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .edu-card {
    opacity: 0;
    transform: translateY(20px) scale(0.97);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .edu-header.reveal,
  .edu-card.reveal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  function revealEducation() {
    const header = document.querySelector('.edu-header');
    const cards = document.querySelectorAll('.edu-card');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        if (entry.target.classList.contains('edu-header')) {
          entry.target.classList.add('reveal');
        } else {
          const index = Array.from(cards).indexOf(entry.target);
          setTimeout(() => entry.target.classList.add('reveal'), index * 120);
        }
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

    if (header) observer.observe(header);
    cards.forEach(card => observer.observe(card));
  }

  revealEducation();
  document.addEventListener('astro:after-swap', revealEducation);
</script>
